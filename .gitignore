# Vendored Euphonic aarch64 wheel: a local-only workaround until aarch64 wheels
# are published to PyPI. CI (x86-64) never needs it, so it is not committed.
# aarch64 developers must extract the wheel here themselves (see README.md).
wheels/*.whl

# Python / build artefacts
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# uv-managed virtual environment
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/

# Sphinx docs build + generated API/gallery output
docs/build/
docs/source/auto_examples/
docs/source/autoapi/
docs/source/sg_execution_times.rst

# Test session artifacts
container_info.json
container.lock
*.tmp.lock
